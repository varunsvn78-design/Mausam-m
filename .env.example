# Copy this file to ".env" (which is git-ignored) and fill in your own values.
# The API server loads it automatically via `node --env-file-if-exists=.env`.
# If MONGODB_URI is left blank/absent, the API runs in in-memory (non-persistent) demo mode.

# Optional. MongoDB Atlas (or any MongoDB) connection string, e.g.:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Never commit real credentials. Restrict Atlas network access and use a least-privilege DB user.
MONGODB_URI=

# Optional. API port (defaults to 4000).
PORT=4000
